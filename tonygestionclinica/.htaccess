# Tony Gallardo Gestion Clinica

DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

# La base de datos nunca debe servirse por HTTP.
<FilesMatch "\.(sqlite|sqlite3|db|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Los assets se piden con ?v=N desde index.html, asi que pueden cachearse
# mucho tiempo: al publicar una version nueva cambia la URL y el navegador
# vuelve a descargarlos. El index.html, en cambio, nunca se cachea, porque
# es quien lleva ese numero de version.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store"
    </FilesMatch>
</IfModule>
